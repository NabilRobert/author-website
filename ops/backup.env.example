# Settings for the nightly backup (ops/backup.sh). Copy to ops/backup.env
# (git-ignored), fill it in, and `chmod 600 backup.env`. Kept apart from
# ops/.env, which the container reads: the S3 keys stay out of the app.

# age public key (age1…) to encrypt to. The private key stays off the server.
AGE_PUBLIC_KEY=
# S3 access for the backups, ideally a key allowed only under framed/ in the bucket.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
# How long copies are kept, here and in S3. The privacy page (src/views/PrivacyView.vue) says 14.
BACKUP_KEEP_DAYS=14
# Optional: a dead-man's-switch URL (for example a daily healthchecks.io check),
# pinged on start, success and failure, so a backup that fails or never runs is noticed.
BACKUP_HEALTHCHECK_URL=
# The running container's name (docker ps); this is the default from ops/compose.yaml.
FRAMED_CONTAINER=framed-framed-1
