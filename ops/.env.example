# Framed's non-secret settings on a server (copy to ops/.env). Secrets go in
# ops/secrets/ instead (ops/make-secrets.sh).
SITE_URL=https://framed.my.id
EMAIL_FROM=Framed <login@framed.my.id>
# Signing up needs an invite; "open" would let anyone sign up.
SIGN_UP_MODE=invite
# Where an email goes for each page a visitor reports (your own address).
# Leave it empty and reports are only stored (takedown-cli.mjs reports).
REPORTS_EMAIL=
# The port on the server's loopback that the proxy forwards to.
FRAMED_PORT=8790
