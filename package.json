{
  "name": "framed",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run build && wrangler pages dev --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "invite": "tsx scripts/create-invite.ts",
    "db:seed:test": "tsx scripts/seed-test-site.ts",
    "build": "vite build",
    "build:node": "vite build && esbuild server/node/main.ts server/node/invite-cli.ts server/node/backup-cli.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outdir=dist-node --out-extension:.js=.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:sqlite": "TEST_DATABASE=sqlite vitest run tests/api",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --build",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:sqlite && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "better-auth": "^1.7.18",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@unhead/vue": "^3.4.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^15.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "miniflare": "4.20260730.0",
    "prettier": "^3.9.10",
    "splitpanes": "^4.1.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.158.0"
  }
}
